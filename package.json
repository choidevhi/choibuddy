{
  "name": "choibuddy",
  "private": true,
  "version": "0.6.3",
  "type": "module",
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts",
    "fetch-node": "node scripts/fetch-node.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
    "test": "node --no-warnings --test bridge/test/*.test.ts ui/test/*.test.ts",
    "bridge": "node --no-warnings bridge/src/main.ts",
    "install-bridge": "node --no-warnings bridge/src/install.ts",
    "uninstall-bridge": "node --no-warnings bridge/src/install.ts --uninstall",
    "tauri": "tauri"
  },
  "packageManager": "pnpm@12.9.1",
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "2.12.2",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
