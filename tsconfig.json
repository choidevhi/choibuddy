{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["bridge/**/*.ts", "shared/**/*.ts", "ui/test/**/*.ts", "ui/src/outbox.ts", "ui/src/attachments.ts", "ui/src/drag-region.ts", "ui/src/chat-patch.ts"]
}
